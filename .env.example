# ==========================================================================
# Le Cortex — modele de configuration. Copier en .env, puis remplir.
#   Windows :  copy .env.example .env
#   Linux   :  cp .env.example .env
#
# Aucune valeur secrete ne figure ici : ce fichier peut etre publie,
# .env ne le peut jamais. Le code charge .env au demarrage (python-dotenv),
# et .env.serper en plus pour la cle Serper.dev.
#
# Regle de lecture : une ligne commentee (#) garde le defaut du code.
# Une ligne decommentee mais vide ECRASE le defaut par du vide. C'est
# volontaire pour les cles obligatoires, a eviter pour LLM_PROVIDER,
# SMTP_HOST, IMAP_HOST, WP_URL, WP_USER et BRAVE_MONTHLY_QUOTA.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. OBLIGATOIRE — Telegram, l'interface avec JOSY
# --------------------------------------------------------------------------
# TG_TOKEN : jeton du bot @JosyEiMasterBot (BotFather)
# TG_CHAT  : identifiant du salon prive qui recoit les propositions
TG_TOKEN=
TG_CHAT=

# --------------------------------------------------------------------------
# 2. OBLIGATOIRE — le modele de langage
# --------------------------------------------------------------------------
# Groq est le seul fournisseur. Sans GROQ_API_KEY valide, le Cortex
# s'arrete au demarrage : "ERREUR_LLM : GROQ_API_KEY absente ou invalide".
# Repli automatique entre modeles Groq : gpt-oss-120b, gpt-oss-20b, qwen3.8-27b.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=METTRE_CLE_GROQ

# --------------------------------------------------------------------------
# 3. Email — prospection et relation client
# --------------------------------------------------------------------------
# HOSTINGER_EMAIL : adresse d'envoi, sert aussi de lien de desinscription RGPD
# HOSTINGER_PASSWORD : mot de passe de la boite
HOSTINGER_EMAIL=
HOSTINGER_PASSWORD=
# SMTP_HOST / IMAP_HOST : laisser commente pour Hostinger
# SMTP_HOST=
# IMAP_HOST=

# --------------------------------------------------------------------------
# 4. Recherche de prospects (mission M1)
# --------------------------------------------------------------------------
# SERPER_API_KEY : Serper.dev — peut aussi vivre dans .env.serper
SERPER_API_KEY=
# SERPER_WEB : 1 pour passer la recherche web par Serper
# SERPER_WEB=
# BRAVE_API_KEY : Brave Search
BRAVE_API_KEY=
# BRAVE_MONTHLY_QUOTA : laisser commente pour garder 2000
# BRAVE_MONTHLY_QUOTA=
# GOOGLE_PLACES_KEY : fiches d'etablissement Google
GOOGLE_PLACES_KEY=

# --------------------------------------------------------------------------
# 5. Google Business Profile — publication
# --------------------------------------------------------------------------
# GBP_CLIENT_ID=
# GBP_CLIENT_SECRET=
# GBP_REFRESH_TOKEN=
# GBP_LOCATION=

# --------------------------------------------------------------------------
# 6. Site web WordPress
# --------------------------------------------------------------------------
# WP_URL : laisser commente pour garder https://josyei.com
# WP_URL=
# WP_USER : laisser commente si le defaut du code convient
# WP_USER=
WP_APP_PASSWORD=

# --------------------------------------------------------------------------
# 7. Divers
# --------------------------------------------------------------------------
# BOOKING_URL : lien d'agenda facultatif ; sans lui, le prospect repond a l'email
# BOOKING_URL=
# CORTEX_DB : chemin de la base ; vide = cortex.db a cote de cortex.py
# CORTEX_DB=
# LIVRAISON_SECRET : signature HMAC des livraisons client
# LIVRAISON_SECRET=
